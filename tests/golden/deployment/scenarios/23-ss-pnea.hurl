# GENERATED by hurl/generate.py -- do not hand-edit.
# Source of truth: configs/member-pnea/pnea.yaml
# Reference: X-Road 7.7.0 development/hurl/scenarios/setup.hurl
# DEMO ONLY -- Test CA, fixed credentials, single host.

############################################################
# ss-pnea -- Progressa National Examination Authority (SS-PNEA)
############################################################

# Check that the Security Server UI is up
GET https://{{ss_pnea_host}}:4000

HTTP 200

# Log in to the Security Server
POST https://{{ss_pnea_host}}:4000/login
[FormParams]
username: {{ss_admin_user}}
password: {{ss_admin_password}}

HTTP 200
[Captures]
ss_pnea_xsrf_token: cookie "XSRF-TOKEN"

# Upload the global configuration anchor downloaded from the Central Server
POST https://{{ss_pnea_host}}:4000/api/v1/system/anchor
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/octet-stream
```
{{gconf_anchor}}
```

HTTP 201

# Initialise the Security Server (owner + server code + token PIN)
POST https://{{ss_pnea_host}}:4000/api/v1/initialization
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/json
{
  "owner_member_class": "{{member_class}}",
  "owner_member_code": "PNEA",
  "security_server_code": "SS-PNEA",
  "software_token_pin": "{{token_pin}}",
  "ignore_warnings": true
}

HTTP 201

# Log in to the software token
PUT https://{{ss_pnea_host}}:4000/api/v1/tokens/0/login
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/json
{
  "password": "{{token_pin}}"
}

HTTP *

# Generate the AUTH key and its CSR in one call
POST https://{{ss_pnea_host}}:4000/api/v1/tokens/0/keys-with-csrs
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/json
{
  "key_label": "Auth key",
  "csr_generate_request": {
    "key_usage_type": "AUTHENTICATION",
    "ca_name": "{{ca_name}}",
    "csr_format": "DER",
    "subject_field_values": {
      "CN": "{{ss_pnea_host}}",
      "C": "{{csr_country}}",
      "O": "Progressa National Examination Authority",
      "subjectAltName": "{{ss_pnea_host}}",
      "serialNumber": "{{xroad_instance}}/SS-PNEA/{{member_class}}"
    }
  }
}

# setup.hurl@7.7.0 notes the API returns 200 here although the OpenAPI model says 201.
HTTP 200

[Captures]
ss_pnea_auth_key_id: jsonpath "$.key.id"
ss_pnea_auth_key_csr_id: jsonpath "$.csr_id"

# Download the AUTH CSR in PEM (the Test CA signs PEM, the SS generates DER)
GET https://{{ss_pnea_host}}:4000/api/v1/keys/{{ss_pnea_auth_key_id}}/csrs/{{ss_pnea_auth_key_csr_id}}?csr_format=PEM
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}

HTTP 200

[Captures]
ss_pnea_auth_key_csr: body

# Sign the AUTH CSR against the Test CA (needs a filename, hence the raw multipart body)
POST http://{{ca_host}}:8888/testca/sign
Content-Type: multipart/form-data; boundary=certboundary
```
--certboundary
Content-Disposition: form-data; name="type"

auth
--certboundary
Content-Disposition: form-data; name="certreq"; filename="auth.csr.pem"

{{ss_pnea_auth_key_csr}}
--certboundary--
```

HTTP 200
[Captures]
ss_pnea_auth_key_cert: body

# Import the AUTH certificate
POST https://{{ss_pnea_host}}:4000/api/v1/token-certificates
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/octet-stream
```
{{ss_pnea_auth_key_cert}}
```

HTTP 201

[Captures]
ss_pnea_auth_key_cert_hash: jsonpath "$.certificate_details.hash"

# Generate the SIGN key and its CSR for PNEA
POST https://{{ss_pnea_host}}:4000/api/v1/tokens/0/keys-with-csrs
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/json
{
  "key_label": "Sign key",
  "csr_generate_request": {
    "key_usage_type": "SIGNING",
    "ca_name": "{{ca_name}}",
    "csr_format": "DER",
    "member_id": "{{xroad_instance}}:{{member_class}}:PNEA",
    "subject_field_values": {
      "CN": "PNEA",
      "C": "{{csr_country}}",
      "O": "Progressa National Examination Authority",
      "subjectAltName": "{{ss_pnea_host}}",
      "serialNumber": "{{xroad_instance}}/SS-PNEA/{{member_class}}"
    }
  }
}

HTTP 200

[Captures]
ss_pnea_sign_key_id: jsonpath "$.key.id"
ss_pnea_sign_key_csr_id: jsonpath "$.csr_id"

# Download the SIGN CSR in PEM
GET https://{{ss_pnea_host}}:4000/api/v1/keys/{{ss_pnea_sign_key_id}}/csrs/{{ss_pnea_sign_key_csr_id}}?csr_format=PEM
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}

HTTP 200

[Captures]
ss_pnea_sign_key_csr: body

# Sign the SIGN CSR against the Test CA
POST http://{{ca_host}}:8888/testca/sign
Content-Type: multipart/form-data; boundary=certboundary
```
--certboundary
Content-Disposition: form-data; name="type"

sign
--certboundary
Content-Disposition: form-data; name="certreq"; filename="sign.csr.pem"

{{ss_pnea_sign_key_csr}}
--certboundary--
```

HTTP 200
[Captures]
ss_pnea_sign_key_cert: body

# Import the SIGN certificate
POST https://{{ss_pnea_host}}:4000/api/v1/token-certificates
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
Content-Type: application/octet-stream
```
{{ss_pnea_sign_key_cert}}
```

HTTP 201

[Captures]
ss_pnea_sign_key_cert_hash: jsonpath "$.certificate_details.hash"

# Register the AUTH certificate (the SS's address is its DNS name on the linkup network)
PUT https://{{ss_pnea_host}}:4000/api/v1/token-certificates/{{ss_pnea_auth_key_cert_hash}}/register
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
{
  "address": "{{ss_pnea_host}}"
}

# setup.hurl@7.7.0: 204, although the OpenAPI model says 200.
HTTP 204

# Approve the registration request on the Central Server.
# This is the explicit alternative to the auto-approve-* flags in local.ini:
# nothing has to be written into /etc/xroad/conf.d on the CS.
GET https://{{cs_host}}:4000/api/v1/management-requests?sort=id&desc=true&status=WAITING
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

[Captures]
ss_pnea_auth_cert_req_id: jsonpath "$.items[0].id"

POST https://{{cs_host}}:4000/api/v1/management-requests/{{ss_pnea_auth_cert_req_id}}/approval
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

# Activate the AUTH certificate
PUT https://{{ss_pnea_host}}:4000/api/v1/token-certificates/{{ss_pnea_auth_key_cert_hash}}/activate
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}

HTTP 204

# Point the Security Server at that timestamping service
POST https://{{ss_pnea_host}}:4000/api/v1/system/timestamping-services
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
{
  "name": "{{tsa_name}}",
  "url": "{{tsa_url}}"
}

HTTP 201

# Add PNEA:EXAMS as a client of ss-pnea
POST https://{{ss_pnea_host}}:4000/api/v1/clients
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}
{
  "ignore_warnings": true,
  "client": {
    "member_class": "{{member_class}}",
    "member_code": "PNEA",
    "subsystem_code": "EXAMS",
    "connection_type": "HTTP"
  }
}

HTTP 201

[Captures]
ss_pnea_client_id: jsonpath "$.id"

# Register the subsystem
PUT https://{{ss_pnea_host}}:4000/api/v1/clients/{{ss_pnea_client_id}}/register
X-XSRF-TOKEN: {{ss_pnea_xsrf_token}}

HTTP 204

# Approve the client registration request on the Central Server
GET https://{{cs_host}}:4000/api/v1/management-requests?sort=id&desc=true&status=WAITING
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

[Captures]
ss_pnea_client_req_id: jsonpath "$.items[0].id"

POST https://{{cs_host}}:4000/api/v1/management-requests/{{ss_pnea_client_req_id}}/approval
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200
