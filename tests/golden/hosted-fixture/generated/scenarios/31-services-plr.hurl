############################################################
# PLR:ENROLMENT -- publish enrolment-api (OPENAPI3)
############################################################

# Add the OpenAPI 3 service description. The Security Server parses servers.url
# from the spec as the forwarding target.
POST https://{{ss_plr_host}}:4000/api/v1/clients/{{ss_plr_client_id}}/service-descriptions
X-XSRF-TOKEN: {{ss_plr_xsrf_token}}
{
  "url": "{{plr_spec_url}}",
  "type": "OPENAPI3",
  "rest_service_code": "enrolment-api"
}

HTTP 201

[Captures]
ss_plr_enrolment_api_description_id: jsonpath "$.id"

# Services are disabled when added -- enable it explicitly
PUT https://{{ss_plr_host}}:4000/api/v1/service-descriptions/{{ss_plr_enrolment_api_description_id}}/enable
X-XSRF-TOKEN: {{ss_plr_xsrf_token}}

# setup.hurl@7.7.0: 200, although the OpenAPI model says 204.
HTTP 200

# Grant PROGRESSA:GOV:PNEA:EXAMS access to enrolment-api -- and nobody else.
# The omission is deliberate: PROGRESSA:GOV:PLR:ENROLMENT is left out so the negative check in
# acceptance/once-only-exchange.md proves the ACL, not an accident of configuration.
POST https://{{ss_plr_host}}:4000/api/v1/clients/{{ss_plr_client_id}}/service-clients/PROGRESSA:GOV:PNEA:EXAMS/access-rights
X-XSRF-TOKEN: {{ss_plr_xsrf_token}}
{
  "items": [
    {
      "service_code": "enrolment-api"
    }
  ]
}

HTTP 201
