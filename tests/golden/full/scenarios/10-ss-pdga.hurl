# GENERATED by hurl/generate.py -- do not hand-edit.
# Source of truth: configs/x-road-bus/2.1.yaml
# Reference: X-Road 7.7.0 development/hurl/scenarios/setup.hurl
# DEMO ONLY -- Test CA, fixed credentials, single host.

############################################################
# ss-pdga -- Progressa Digital Government Authority (SS-PDGA)
############################################################

# Check that the Security Server UI is up
GET https://{{ss_pdga_host}}:4000

HTTP 200

# Log in to the Security Server
POST https://{{ss_pdga_host}}:4000/login
[FormParams]
username: {{ss_admin_user}}
password: {{ss_admin_password}}

HTTP 200
[Captures]
ss_pdga_xsrf_token: cookie "XSRF-TOKEN"

# Upload the global configuration anchor downloaded from the Central Server
POST https://{{ss_pdga_host}}:4000/api/v1/system/anchor
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/octet-stream
```
{{gconf_anchor}}
```

HTTP 201

# Initialise the Security Server (owner + server code + token PIN)
POST https://{{ss_pdga_host}}:4000/api/v1/initialization
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/json
{
  "owner_member_class": "{{member_class}}",
  "owner_member_code": "PDGA",
  "security_server_code": "SS-PDGA",
  "software_token_pin": "{{token_pin}}",
  "ignore_warnings": true
}

HTTP 201

# Log in to the software token
PUT https://{{ss_pdga_host}}:4000/api/v1/tokens/0/login
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/json
{
  "password": "{{token_pin}}"
}

HTTP *

# Capture the Test CA's name from the global configuration. Captured once on the
# management Security Server and reused by every later CSR in the run.
GET https://{{ss_pdga_host}}:4000/api/v1/certificate-authorities
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 200

[Captures]
ca_name: jsonpath "$[0].name"

# Generate the AUTH key and its CSR in one call
POST https://{{ss_pdga_host}}:4000/api/v1/tokens/0/keys-with-csrs
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/json
{
  "key_label": "Auth key",
  "csr_generate_request": {
    "key_usage_type": "AUTHENTICATION",
    "ca_name": "{{ca_name}}",
    "csr_format": "DER",
    "subject_field_values": {
      "CN": "{{ss_pdga_host}}",
      "C": "{{csr_country}}",
      "O": "Progressa Digital Government Authority",
      "subjectAltName": "{{ss_pdga_host}}",
      "serialNumber": "{{xroad_instance}}/SS-PDGA/{{member_class}}"
    }
  }
}

# setup.hurl@7.7.0 notes the API returns 200 here although the OpenAPI model says 201.
HTTP 200

[Captures]
ss_pdga_auth_key_id: jsonpath "$.key.id"
ss_pdga_auth_key_csr_id: jsonpath "$.csr_id"

# Download the AUTH CSR in PEM (the Test CA signs PEM, the SS generates DER)
GET https://{{ss_pdga_host}}:4000/api/v1/keys/{{ss_pdga_auth_key_id}}/csrs/{{ss_pdga_auth_key_csr_id}}?csr_format=PEM
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 200

[Captures]
ss_pdga_auth_key_csr: body

# Sign the AUTH CSR against the Test CA (needs a filename, hence the raw multipart body)
POST http://{{ca_host}}:8888/testca/sign
Content-Type: multipart/form-data; boundary=certboundary
```
--certboundary
Content-Disposition: form-data; name="type"

auth
--certboundary
Content-Disposition: form-data; name="certreq"; filename="auth.csr.pem"

{{ss_pdga_auth_key_csr}}
--certboundary--
```

HTTP 200
[Captures]
ss_pdga_auth_key_cert: body

# Import the AUTH certificate
POST https://{{ss_pdga_host}}:4000/api/v1/token-certificates
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/octet-stream
```
{{ss_pdga_auth_key_cert}}
```

HTTP 201

[Captures]
ss_pdga_auth_key_cert_hash: jsonpath "$.certificate_details.hash"

# Generate the SIGN key and its CSR for PDGA
POST https://{{ss_pdga_host}}:4000/api/v1/tokens/0/keys-with-csrs
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/json
{
  "key_label": "Sign key",
  "csr_generate_request": {
    "key_usage_type": "SIGNING",
    "ca_name": "{{ca_name}}",
    "csr_format": "DER",
    "member_id": "{{xroad_instance}}:{{member_class}}:PDGA",
    "subject_field_values": {
      "CN": "PDGA",
      "C": "{{csr_country}}",
      "O": "Progressa Digital Government Authority",
      "subjectAltName": "{{ss_pdga_host}}",
      "serialNumber": "{{xroad_instance}}/SS-PDGA/{{member_class}}"
    }
  }
}

HTTP 200

[Captures]
ss_pdga_sign_key_id: jsonpath "$.key.id"
ss_pdga_sign_key_csr_id: jsonpath "$.csr_id"

# Download the SIGN CSR in PEM
GET https://{{ss_pdga_host}}:4000/api/v1/keys/{{ss_pdga_sign_key_id}}/csrs/{{ss_pdga_sign_key_csr_id}}?csr_format=PEM
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 200

[Captures]
ss_pdga_sign_key_csr: body

# Sign the SIGN CSR against the Test CA
POST http://{{ca_host}}:8888/testca/sign
Content-Type: multipart/form-data; boundary=certboundary
```
--certboundary
Content-Disposition: form-data; name="type"

sign
--certboundary
Content-Disposition: form-data; name="certreq"; filename="sign.csr.pem"

{{ss_pdga_sign_key_csr}}
--certboundary--
```

HTTP 200
[Captures]
ss_pdga_sign_key_cert: body

# Import the SIGN certificate
POST https://{{ss_pdga_host}}:4000/api/v1/token-certificates
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
Content-Type: application/octet-stream
```
{{ss_pdga_sign_key_cert}}
```

HTTP 201

[Captures]
ss_pdga_sign_key_cert_hash: jsonpath "$.certificate_details.hash"

# Register the AUTH certificate (the SS's address is its DNS name on the linkup network)
PUT https://{{ss_pdga_host}}:4000/api/v1/token-certificates/{{ss_pdga_auth_key_cert_hash}}/register
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "address": "{{ss_pdga_host}}"
}

# setup.hurl@7.7.0: 204, although the OpenAPI model says 200.
HTTP 204

# Approve the registration request on the Central Server.
# This is the explicit alternative to the auto-approve-* flags in local.ini:
# nothing has to be written into /etc/xroad/conf.d on the CS.
GET https://{{cs_host}}:4000/api/v1/management-requests?sort=id&desc=true&status=WAITING
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

[Captures]
ss_pdga_auth_cert_req_id: jsonpath "$.items[0].id"

POST https://{{cs_host}}:4000/api/v1/management-requests/{{ss_pdga_auth_cert_req_id}}/approval
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

# Nominate this Security Server as the one hosting the management services
POST https://{{cs_host}}:4000/api/v1/management-services-configuration/register-provider
X-XSRF-TOKEN: {{cs_xsrf_token}}
{
  "security_server_id": "{{xroad_instance}}:{{member_class}}:PDGA:SS-PDGA"
}

HTTP 200

# Add the MANAGEMENT subsystem as a client of ss-pdga
POST https://{{ss_pdga_host}}:4000/api/v1/clients
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "ignore_warnings": true,
  "client": {
    "member_class": "{{member_class}}",
    "member_code": "PDGA",
    "subsystem_code": "MANAGEMENT",
    "connection_type": "HTTP"
  }
}

HTTP 201

[Captures]
ss_pdga_client_id: jsonpath "$.id"

# Read the management service addresses the Central Server publishes
GET https://{{cs_host}}:4000/api/v1/management-services-configuration
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

[Captures]
cs_management_service_address: jsonpath "$.services_address"
cs_management_service_wsdl: jsonpath "$.wsdl_address"

# Publish the management services (WSDL) on the management Security Server
POST https://{{ss_pdga_host}}:4000/api/v1/clients/{{ss_pdga_client_id}}/service-descriptions
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "url": "{{cs_management_service_wsdl}}",
  "type": "WSDL",
  "ignore_warnings": true
}

HTTP 201

[Captures]
ss_pdga_management_description_id: jsonpath "$.id"
ss_pdga_auth_cert_deletion_service_id: jsonpath "$.services[0].id"

# Point every management service at the CS's services address
PATCH https://{{ss_pdga_host}}:4000/api/v1/services/{{ss_pdga_auth_cert_deletion_service_id}}
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "ignore_warnings": true,
  "ssl_auth": false,
  "ssl_auth_all": true,
  "timeout": 60,
  "timeout_all": true,
  "url": "{{cs_management_service_address}}",
  "url_all": true
}

# Grant the security-server-owners global group access to the management services
POST https://{{ss_pdga_host}}:4000/api/v1/clients/{{ss_pdga_client_id}}/service-clients/{{xroad_instance}}:security-server-owners/access-rights
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "items": [
    { "service_code": "authCertDeletion" },
    { "service_code": "clientDeletion" },
    { "service_code": "clientReg" },
    { "service_code": "ownerChange" },
    { "service_code": "clientEnable" },
    { "service_code": "clientDisable" },
    { "service_code": "addressChange" },
    { "service_code": "clientRename" },
    { "service_code": "maintenanceModeEnable" },
    { "service_code": "maintenanceModeDisable" }
  ]
}

# Enable the management service description
PUT https://{{ss_pdga_host}}:4000/api/v1/service-descriptions/{{ss_pdga_management_description_id}}/enable
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 200

# Activate the AUTH certificate
PUT https://{{ss_pdga_host}}:4000/api/v1/token-certificates/{{ss_pdga_auth_key_cert_hash}}/activate
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 204

# Read the timestamping service out of the global configuration
GET https://{{ss_pdga_host}}:4000/api/v1/timestamping-services
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}

HTTP 200

[Captures]
tsa_name: jsonpath "$[0].name"
tsa_url: jsonpath "$[0].url"

# Point the Security Server at that timestamping service
POST https://{{ss_pdga_host}}:4000/api/v1/system/timestamping-services
X-XSRF-TOKEN: {{ss_pdga_xsrf_token}}
{
  "name": "{{tsa_name}}",
  "url": "{{tsa_url}}"
}

HTTP 201
