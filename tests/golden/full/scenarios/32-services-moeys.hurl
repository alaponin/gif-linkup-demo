############################################################
# MOEYS:PEMIS -- publish pemis-api (OPENAPI3)
############################################################

# Add the OpenAPI 3 service description. The Security Server parses servers.url
# from the spec as the forwarding target.
POST https://{{ss_moeys_host}}:4000/api/v1/clients/{{ss_moeys_client_id}}/service-descriptions
X-XSRF-TOKEN: {{ss_moeys_xsrf_token}}
{
  "url": "{{moeys_spec_url}}",
  "type": "OPENAPI3",
  "rest_service_code": "pemis-api"
}

HTTP 201

[Captures]
ss_moeys_pemis_api_description_id: jsonpath "$.id"

# Services are disabled when added -- enable it explicitly
PUT https://{{ss_moeys_host}}:4000/api/v1/service-descriptions/{{ss_moeys_pemis_api_description_id}}/enable
X-XSRF-TOKEN: {{ss_moeys_xsrf_token}}

# setup.hurl@7.7.0: 200, although the OpenAPI model says 204.
HTTP 200
