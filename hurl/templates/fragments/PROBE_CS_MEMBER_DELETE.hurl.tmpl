
# Probe for the cs.members_member reversal (join-c plan Task 2, Step 3):
# "has this member already been deleted?" cs.members_member carries no
# forward probe (Plan A Task 5 classified it (b), its unique member_code
# key makes a repeat 409) -- this one exists purely for the reversal
# direction.
#
# CONFIRMED LIVE (apps/join-api/tests/fixtures/xroad/
# unjoin.cs_member_delete.probe.json, docs/xroad-770-notes.md #11 finding
# 4): GET /clients?q=<member_code> always 200s -- absence is an EMPTY
# clients LIST, not a 404 (the second of the two probes in this task that
# does NOT signal absence with a 404 -- do not assume it does). There is
# no GET /subsystems/{id} on the CS at all (it is 405, not 404), so this
# is also the only viable read for "is this member's identity gone".
GET https://{{cs_host}}:4000/api/v1/clients?q=@MEMBER_CODE@
X-XSRF-TOKEN: {{cs_xsrf_token}}

HTTP 200

[Captures]
cs_member_delete_probe_clients: body
