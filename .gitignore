.env
__pycache__/
*.pyc
out/
# Concatenated Hurl run files — rebuilt by hurl/run-linkup.sh on every run.
hurl/.build/
# Generated by hurl/generate.py from configs/ + manifest.yaml +
# deployment.yaml on every run -- never hand-edited, never committed
# (hurl/README.md "Do not hand-edit"). Explicit here, not just by
# convention, so an accidental `git add -A` can't stage a stale one.
hurl/scenarios/
hurl/vars.env
hurl/topology.json
hurl/topology.sh
hurl/compose.members.yml
# Local dev/test venv for apps/console (pytest/httpx/fastapi) -- the console
# container installs its own deps in-image (apps/console/Dockerfile); this is
# only for running apps/console/tests locally during development.
.venv/
