# Holds live credentials (token PIN, admin password) -- generated by
# scripts/gen-secrets.sh, never hand-edited, never committed.
.env
__pycache__/
*.pyc
out/
# Concatenated Hurl run files — rebuilt by hurl/run-linkup.sh on every run.
hurl/.build/
# Generated by hurl/generate.py from configs/ + manifest.yaml +
# deployment.yaml on every run -- never hand-edited, never committed
# (hurl/README.md "Do not hand-edit"). Explicit here, not just by
# convention, so an accidental `git add -A` can't stage a stale one.
hurl/scenarios/
# Also holds the token PIN and admin password in cleartext (read from .env
# at generation time) -- mode 600 at generation, same reason as .env above.
hurl/vars.env
hurl/topology.json
hurl/topology.sh
hurl/compose.members.yml
# tests/golden/{full,lite}/ hold files with these same names, generated from
# a fixed, fake tests/golden/env.fixture -- but they are a committed test
# FIXTURE (testing-strategy plan Task 1), not a working artefact, and none of
# the patterns above match them anyway (they live under tests/golden/, not
# hurl/). Said explicitly here so nobody "fixes" that by widening a pattern.
# Local dev/test venv for apps/console (pytest/httpx/fastapi) -- the console
# container installs its own deps in-image (apps/console/Dockerfile); this is
# only for running apps/console/tests locally during development.
.venv/

# Working plans and their notes. They record how a change was arrived at, which
# is useful while making it and noise once it has landed -- the change itself,
# its tests and docs/decisions/ carry what survives. Kept locally, never
# committed.
docs/decisions/superpowers/
